# Copie somente para seu ambiente privado. Este projeto não carrega .env automaticamente.
NODE_ENV=development
HOST=127.0.0.1
PORT=4180
FILAMIND_STORAGE=json
DATABASE_URL=
# Em produção, use a URL privada do Neon com sslmode=verify-full.
FILAMIND_UPLOADS_DIR=
FILAMIND_IMAGE_STORAGE=local
# Para Supabase Storage: bucket público apenas para leitura de imagens; gravações só no backend.
# Configure estas variáveis somente no ambiente privado do backend. Nunca use prefixo VITE_.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=
# Endereços de hospedagem futura; a API atual exige mesma origem e ainda não os consome.
# FILAMIND_PUBLIC_URL=
# FILAMIND_API_URL=
# A SPA e a API usam a mesma origem. CORS entre origens ainda não está habilitado.
# FILAMIND_CORS_ORIGIN=
# Endereços públicos do frontend podem ser definidos no build Vite:
# VITE_SYSTEM_URL=
# VITE_PRO_URL=
# Autenticação administrativa remota: mantenha off até aplicar a migration 002 e criar o primeiro administrador.
# Use HTTPS na origem pública em produção; HTTP só em 127.0.0.1 durante desenvolvimento.
FILAMIND_ADMIN_AUTH=off
FILAMIND_ADMIN_ORIGIN=
# Em produção, informe a origem HTTPS canônica exata, sem barra final.
