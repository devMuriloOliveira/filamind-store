# Copie somente para seu ambiente privado. Este projeto não carrega .env automaticamente.
NODE_ENV=development
HOST=127.0.0.1
PORT=4180
FILAMIND_STORAGE=json
DATABASE_URL=
FILAMIND_UPLOADS_DIR=
